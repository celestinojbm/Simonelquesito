# ============================================================
# Salsamentaria — Variables de entorno
# Instancia de la plantilla marketcastilla (ver docs/PLANTILLA_REPLICABLE.md).
# Copia este archivo a .env.local y completa los valores.
# NUNCA subas .env.local al repositorio.
# ============================================================

# --- Base de datos (PostgreSQL 16+) ---
DATABASE_URL=postgres://salsamentaria:salsamentaria_dev_password@localhost:5432/salsamentaria

# --- Preset de negocio (solo se usa al correr el seed, no en runtime) ---
# BUSINESS_PRESET=salsamentaria npm run db:seed

# --- Plantilla replicable: modo sin storefront público ---
# Esta instancia es admin-only (sin app de consumidores): "false" apaga TODA
# la tienda pública (/, /producto, /categoria, /carrito, /checkout, /cuenta,
# /ofertas, /pago-sandbox, /pedido, /buscar, /ubicacion) y redirige a /login;
# solo quedan activos /admin, /api y /repartidor.
STOREFRONT_ENABLED=false

# --- Sesiones y seguridad ---
# Genera uno con: openssl rand -hex 32
SESSION_SECRET=cambia-esto-por-un-secreto-de-64-hex

# --- Pagos ---
# Proveedor activo: "sandbox" (demo) o "mercado_pago" (pasarela real).
PAYMENT_PROVIDER=sandbox
# Secreto para firmar/verificar webhooks del proveedor sandbox (demo).
PAYMENT_WEBHOOK_SECRET=sandbox-webhook-secret-demo

# Wompi (plan B — dispersión posterior, sin split en la fuente)
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=

# --- Mercado Pago (pasarela real con split 90/10 en la fuente) ---
# Guía completa paso a paso: docs/MERCADOPAGO.md
# Credenciales de la APLICACIÓN (cuenta de la agencia, panel de
# desarrolladores de MP). El negocio se conecta por OAuth desde
# Admin → Integraciones — no necesita pegar tokens.
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
# "Clave secreta" del webhook (misma pantalla donde se registra la URL
# /api/webhooks/payments/mercadopago en el panel de MP).
MERCADOPAGO_WEBHOOK_SECRET=
# Cifra los tokens OAuth del negocio en la base de datos.
# Genera una con: openssl rand -hex 32
INTEGRATION_CREDENTIALS_KEY=
# URL pública de la app (para notification_url y back_urls de MP).
# En Vercel puede omitirse: se usa VERCEL_PROJECT_PRODUCTION_URL.
APP_URL=

# --- Mensajería / WhatsApp ---
# Proveedor activo: "console" en demo (simula envíos y los registra en BD).
# Con la cuenta de Meta lista, cambiar a "whatsapp_cloud" para enviar de verdad.
MESSAGING_PROVIDER=console
# WhatsApp Business Cloud API (pendiente de completar — requiere cuenta oficial;
# checklist completo en docs/WHATSAPP_ASSISTANT.md)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Token inventado por nosotros; se pega igual en la config del webhook en Meta.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# "App secret" de la app de Meta: firma los webhooks entrantes (obligatorio).
WHATSAPP_APP_SECRET=

# --- Correo (verificación para crédito en línea) ---
# "console" (demo): NO envía; el código queda en Admin → Mensajes para probar.
# "resend": envía de verdad usando la API de Resend (requiere las dos de abajo).
EMAIL_PROVIDER=console
RESEND_API_KEY=
# Remitente verificado en Resend, ej. "Market Castilla <no-responder@tudominio.com>"
EMAIL_FROM=

# --- Asistente con IA (bot de pedidos por WhatsApp y simulador del panel) ---
# API key de Anthropic (console.anthropic.com). Sin ella el bot transfiere
# todas las conversaciones a una persona en lugar de responder con IA.
ANTHROPIC_API_KEY=

# --- Cron (canastas recurrentes) ---
# Secreto que Vercel manda en Authorization al invocar /api/cron/canastas
# (Settings → Environment Variables; Vercel lo inyecta automáticamente en
# sus crons cuando existe). Sin él, el cron queda apagado y las canastas se
# generan con el botón "Generar ahora" del panel.
CRON_SECRET=

# --- Bot de LLAMADAS (Twilio Programmable Voice) ---
# Auth Token de la cuenta de Twilio: valida la firma de los webhooks de voz.
# Sin él, /api/webhooks/voice responde 503 (bot de voz apagado).
TWILIO_AUTH_TOKEN=
# Teléfono al que se TRANSFIEREN las llamadas cuando el bot pasa a humano.
# Por defecto usa el teléfono del negocio (business.contact.phone).
VOICE_FORWARD_PHONE=

# --- Mapas (desacoplado; el MVP usa zonas por barrio sin mapa) ---
MAPS_PROVIDER=none
MAPS_API_KEY=

# --- POS (Treinta) ---
# No existe API pública de Treinta; la sincronización del MVP es por CSV/Excel.
POS_PROVIDER=csv

# --- Marketplaces (Rappi/DiDi) — pendiente de acceso oficial ---
RAPPI_CLIENT_ID=
RAPPI_CLIENT_SECRET=
DIDI_APP_ID=
DIDI_APP_SECRET=

# --- Negocio (parámetros pendientes de completar por el propietario) ---
# Teléfono de WhatsApp del negocio, con indicativo. Ej: 57XXXXXXXXXX
BUSINESS_WHATSAPP_NUMBER=PENDIENTE
