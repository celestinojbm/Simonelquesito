{
  "name": "salsamentaria",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema de gestión (admin, inventario, pedidos, reparto) para una salsamentaria en Bogotá — instancia de la plantilla marketcastilla",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/db/seed.ts",
    "demo": "npm run db:push && npm run db:seed && next dev"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@hookform/resolvers": "^5.1.1",
    "@zxing/browser": "^0.1.5",
    "@zxing/library": "^0.21.3",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.44.2",
    "next": "^15.3.4",
    "pg": "^8.16.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.58.1",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@tailwindcss/postcss": "^4.1.10",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.15.32",
    "@types/pg": "^8.15.4",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "drizzle-kit": "^0.31.1",
    "eslint": "^9.29.0",
    "eslint-config-next": "^15.3.4",
    "tailwindcss": "^4.1.10",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
